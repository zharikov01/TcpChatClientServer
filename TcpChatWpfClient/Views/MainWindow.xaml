<Window x:Class="TcpChatWpfClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Задание на 06.11.2026 - клиент TCP-чата"
        Height="550"
        Width="750"
        MinHeight="350"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=TbxMessage}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Состояние подключения -->
        <TextBlock Grid.Row="0"
                   Style="{StaticResource StatusStyle}"
                   Text="{Binding Status}"/>

        <!-- Сообщения сервера и сообщения команд клиента -->
        <Border Grid.Row="1"
                BorderBrush="SteelBlue"
                BorderThickness="1"
                Margin="0 0 0 10">
            <ScrollViewer x:Name="SvwChat"
                          VerticalScrollBarVisibility="Auto"
                          Background="AliceBlue">
                <TextBlock x:Name="TblChat"
                           Style="{StaticResource ChatStyle}"
                           Text="{Binding ChatLog}"/>
            </ScrollViewer>
        </Border>

        <!-- Ввод сообщений и команд клиента, отправка по Enter или кнопкой -->
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource ButtonStyle}"
                    Command="{Binding SendCommand}">
                Отправить
            </Button>

            <TextBox x:Name="TbxMessage"
                     Style="{StaticResource InputStyle}"
                     Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
    </Grid>
</Window>
